rules_version = '2';

// Clients READ their own data; all writes to workouts/ and games/ go through
// Cloud Functions, so a compromised client cannot corrupt the game list that
// the detection hint depends on.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Google Health refresh tokens. Admin SDK only — never reachable from a
      // client, even the account's own.
      match /private/{document=**} {
        allow read, write: if false;
      }

      match /workouts/{workoutId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /games/{gameId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
