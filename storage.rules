rules_version = '2';

// Images are written by Cloud Functions only; clients read their own.
// Drafts are a separate top-level prefix so a lifecycle rule can expire them
// without any chance of matching committed workout images.
service firebase.storage {
  match /b/{bucket}/o {
    match /workouts/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /drafts/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
