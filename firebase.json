{
  "functions": {
    "source": "functions",
    "runtime": "nodejs24",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "scripts/**",
      "src/**/*.test.ts",
      "*.local"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "lib/**/*.map"
    ],
    "rewrites": [
      {
        "source": "/api/parse",
        "function": "parse"
      },
      {
        "source": "/api/commit",
        "function": "commit"
      },
      {
        "source": "/api/health/**",
        "function": "health"
      },
      {
        "source": "/share-target",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "npm --prefix functions run build:web"
    ]
  }
}
