{
  "name": "StairGamer",
  "short_name": "StairGamer",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#171A2B",
  "theme_color": "#171A2B",
  "icons": [
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "image", "accept": ["image/*"] }]
    }
  }
}
