{
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": true,
    // Matches the main config: a transitive @types mismatch in a dependency
    // must not fail the hosting predeploy build.
    "skipLibCheck": true,
    "outDir": "../public/lib",
    "declaration": false,
    "sourceMap": false
  },
  // The pure modules only. Shipping the same source to both sides is what
  // stops the conversion and game-matching rules from drifting between the
  // confirmation screen and the server that stores the result.
  "files": [
    "src/stairs.ts",
    "src/games.ts",
    "src/confirmState.ts",
    "src/timelapseRange.ts"
  ]
}
